# Docker Compose reads this file automatically from the repo root.
# Copy to `.env` and set JWT_SECRET before `docker compose up --build`:
#
#   cp .env.example .env
#   # macOS / Linux — paste a fresh secret:
#   openssl rand -base64 48
#
# Required for Compose (interpolated into api service):
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48-min-32-chars

# Seed demo users/products on API container start (true for first boot).
RUN_SEED=true
