# Frontend (Next.js) — copy to `web/.env.local` for local `npm run dev`.
# Next.js loads `.env.local` automatically (preferred over `.env` for secrets/local overrides).

# Browser-facing API origin (also used for PDF links / scan beacon).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server Components / SSR fetch origin. In Docker Compose this is set to http://api:3000.
# For local `next dev` against a local API, leave unset or equal to NEXT_PUBLIC_API_URL.
# INTERNAL_API_URL=http://localhost:3000
