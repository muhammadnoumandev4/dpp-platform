# Backend (NestJS) — copy to `api/.env` for local `npm run start:dev`.
# When Postgres runs via `docker compose up -d postgres`, use host port 5433.

# Required
DATABASE_URL=postgresql://dpp:dpp@localhost:5433/dpp
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48-min-32-chars

# Server
PORT=3000
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
COOKIE_SECURE=false

# Trust reverse-proxy headers only behind a real edge (leave empty locally).
TRUST_PROXY=

# Scan analytics fallback country when geoip cannot resolve (e.g. private IPs).
SCAN_COUNTRY_FALLBACK=XX

# Optional dedicated pepper for scan IP HMAC (falls back to JWT_SECRET).
# SCAN_IP_PEPPER=

# Redis — leave REDIS_URL empty to use in-memory cache fallback.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=dpp:
CACHE_MAX_MEMORY_ENTRIES=1000

# Alternative split Redis settings (optional; used when REDIS_URL is unset):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false
